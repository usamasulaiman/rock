# OCI Ampere A1 — primary dev host (guide §2). Non-secret; safe to commit.
ROLE=dev
ROCK_USER=dev
TS_HOSTNAME=rock-oci
SWAP_MB=4096
AUTO_REBOOT=false
# Extra outbound ports beyond DNS/NTP/HTTP(S)/Tailscale. 22 = git over ssh.
EGRESS_EXTRA="22/tcp"
# Command run as the working user to install herdr (empty = skip).
HERDR_INSTALL_CMD=""
# Public keys allowed to ssh in ('|' separated). Empty = bin/render uses ~/.ssh/id_ed25519.pub.
SSH_PUBLIC_KEYS=""
